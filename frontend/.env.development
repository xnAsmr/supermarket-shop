# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
VITE_API_PROXY_URL = http://localhost:8085

# Delete console
VITE_DROP_CONSOLE = false

# 知识库（帮助中心）站点地址（本地预览：docs-site 的 pnpm docs:dev 默认 http://localhost:5173）
VITE_HELP_DOCS_URL = http://localhost:5173