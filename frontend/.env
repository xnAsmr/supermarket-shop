# 【通用】环境变量

#  版本号
VITE_VERSION = 3.0.2

# 端口号
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro

# 是否强制使用本地 Mock 数据（true = 不请求后端，全部走 mock；false = 优先请求后端，后端不可达时自动降级 mock）
VITE_USE_MOCK = false

# 知识库（帮助中心）站点地址：内嵌到系统 /help 页面的 iframe 地址
# 本地预览：先进入 docs-site 目录执行 pnpm docs:dev（默认 http://localhost:5173）
# 生产部署：将 docs-site 构建产物部署到同源子目录（如 /help-docs/）并改为对应地址，或填写独立站点地址
VITE_HELP_DOCS_URL = http://localhost:5173
