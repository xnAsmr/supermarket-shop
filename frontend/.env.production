# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀（部署时改为实际后端地址，如 https://api.example.com）
VITE_API_URL = http://localhost:8085

# Delete console
VITE_DROP_CONSOLE = true

# 知识库（帮助中心）站点地址：生产部署时改为实际地址
# 建议将 docs-site 构建产物（docs-site/dist）部署到同源子目录（如 /help-docs/）并填写 /help-docs/
VITE_HELP_DOCS_URL = http://localhost:5173